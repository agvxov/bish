#!bish

# unset any variable which system may be using
unset tecreset os architecture kernelrelease internalip externalip nameserver loadaverage

set opt 0
getopt {i j v} $args {
    i {
        set opt i
    }
    v {
        set opt v
    }
    j {
        set opt j
    }
    ? {
        puts "Invalid arg"
    }
}

if {$opt == "i"} {
    set wd [pwd]
    puts [open /tmp/scriptname] [expr [basename [test -L $0]] && [readlink $0] || [echo $0]]
    set scriptname $wd[slurp /tmp/scriptname]
    #su -c "cp $scriptname /usr/bin/monitor" root && echo "Congratulations! Script Installed, now run monitor Command" || echo "Installation failed"
    exit
}

if {$opt == "v"} {
    puts "tecmint_monitor version 0.3\nDesigned by Tecmint.com\nReleased Under Apache 2.0 License"
    exit
}

#functions
proc GetVersionFromFile {filename} {
    set ::VERSION [->
        cat $filename
        |
        tr "\n" ' '
        |
        sed s/.*VERSION.*=\ //
    ]
}
proc remove_files {} {
    # Remove Temporary Files
    rm /tmp/who /tmp/ramcache /tmp/diskusage
}

#define output constants and tmp files
set internet [expr [ping -c 1 google.com] ? "Connected" : "Disconnected"]

set os ""
set os [-> uname -o || uname -s]
set architecture  [uname -m]
set kernelrelease [uname -r]
set hostname      [hostname]

set internalip [-> hostname -I || {ip a | grep inet | grep -v "host lo" | tr / " " | awk {print $2}}]
set USEDIG [expr [dig] ? 1 : 0]
if {$USEDIG} {
    set externalip [dig +short myip.opendns.com @resolver1.opendns.com]
} else {
    set externalip [curl -s ipecho.net/plain]"\n"
}
set nameservers [pipe {cat /etc/resolv.conf} {grep -v ^\#} {awk '{print $2}'}]

set loadaverage [-> {top -n 1 -b || {echo q | top} | grep -i "load average:"} | awk -F'average:' '{print $2}' | awk '{print $1" "$2" "$2}']
set tecuptime [pipe {uptime} {awk '{print $3,$4}'} {cut -f1 -d,}]
set OS   [uname -s]
set REV  [uname -r]
set MACH [uname -m]
if {$OS eq "SunOS"} {
    set OS "Solaris"
    set ARCH [uname -p]
    set OSSTR {$OS $REV($ARCH [uname -v])}
} elseif {$OS eq "AIX"} {
    set OSSTR {$OS [oslevel] ([oslevel -r])}
}
elif {$OS eq "Linux"} {
    set KERNEL [uname -r]
    set PSUEDONAME ""
    set REV ""
    if [file exists "/etc/redhat-release"] {
        set DIST "RedHat"
        set PSUEDONAME [pipe {cat /etc/redhat-release} {sed s/.*\(//} {sed s/\)//}]
        set REV [pipe {cat /etc/redhat-release} {sed s/.*release\ //} {sed s/\ .*//}]
    } elseif [file exists "/etc/SuSE-release"] {
        set DIST [cat /etc/SuSE-release | tr "\n" ' '| sed s/VERSION.*//]
        set REV  [cat /etc/SuSE-release | tr "\n" ' ' | sed s/.*=\ //]
    } elseif [file exists "/etc/mandrake-release"] {
        set DIST "Mandrake"
        set PSUEDONAME [cat /etc/mandrake-release | sed s/.*\(// | sed s/\)//]
        set REV [cat /etc/mandrake-release | sed s/.*release\ // | sed s/\ .*//]
    } elseif [file exists /etc/os-release] {
        set DIST [awk -F "PRETTY_NAME=" {{print $2}} /etc/os-release | tr -d '\n']
    } elseif [file exists "/etc/debian_version"] {
        set DIST "Debian "[cat /etc/debian_version]
    }
    if [file exists "/etc/UnitedLinux-release"] {
        set DIST "${DIST}"[cat /etc/UnitedLinux-release | tr "\n" ' ' | sed s/VERSION.*//]
    }
    set OSSTR "${OS} ${DIST} ${REV}(${PSUEDONAME}${KERNEL} ${MACH})"
}
SKIPWHO=0 && who 2>/dev/null > /tmp/who || SKIPWHO=1
(free -h 2>/dev/null || free )| grep -v + | grep -v Total: > /tmp/ramcache
df -h| grep '^Filesystem\|^/dev/sd\|^/dev/mapper/\|^/dev/root\|^/dev/mm\|^overlay' > /tmp/diskusage

if {$opt == "j"} {
    puts "{"
    puts {"internet":[-> puts $internet | jq -R '.')],}
    puts {"os_type":[-> puts $os | jq -R '.'],}
    puts {"os_version":[-> puts $OSSTR | jq -R '.'],}
    puts {"architecture":[-> puts $architecture | jq -R '.'],}
    puts {"kernel_release":[-> puts $kernelrelease | jq -R '.'],}
    puts {"hostname":[-> puts $hostname | jq -R '.'],}
    puts {"ip_internal":[-> puts $internalip | jq -R -c 'split(" ")'],}
    puts {"ip_external":[-> puts $externalip | jq -R -c 'split(" ")'],}
    puts {"name_servers":[-> puts $nameservers | jq -R -c 'split(" ")'],}
    if {$SKIPWHO != "1"} {
        puts {"logged_in_users": }[cat /tmp/who | tr "()" "  " | sed 's/  \+/  /g' | sed 's/ $//g' | jq -R -c 'split("  ")' | jq  -s -c '.'],
    }
    puts {"memory":}[-> cat /tmp/ramcache | grep "Mem" | awk '{$1="";print $0}' | xargs | jq -R -c 'split(" ")'],
    puts {"swap":}[-> cat /tmp/ramcache | grep "Swap" | awk '{$1="";print $0}' | xargs | jq -R -c 'split(" ")'],
    puts {"disk":}[-> tail -n +2 /tmp/diskusage | sed 's/ \+/ /g' | jq -R -c 'split(" ")' | jq  -s -c '.'],
    puts {"load":}[-> echo $loadaverage | jq -R -c 'split(", ")'],
    puts {"uptime":}[-> echo $tecuptime | jq -R '.']
    puts "}"
    puts
    remove_files
    exit
}

if [[llength $argv] == 0] {
    # Define Variable tecreset
    set tecreset [-> tput sgr0 || echo -e {\E[0m}]

    # Check if connected to Internet or not
    puts {\E[32m}"Internet :" $tecreset $internet

    # Check OS Type
    puts {\E[32m}"Operating System Type :" $tecreset $os

    #set tmposrelease [-> cat /etc/os-release | grep "NAME|VERSION" | -v "VERSION_ID" | grep -v 'PRETTY_NAME']
    #-> {puts {\E[32m}"OS Name :"$tecreset}
    #    &&
    #    set $tmposrelease | grep -v "VERSION" | grep -v "CPE_NAME" | cut -f2 -d\"
    #-> {puts {\E[32m}"OS Version :"$tecreset}
    #    &&
    #    set $tmposrelease | grep -v "NAME" | grep -v "CT_VERSION" | cut -f2 -d\"
    puts {\E[32m}"OS Version :" $tecreset $OSSTR
    # Check Architecture
    puts {\E[32m}"Architecture :" $tecreset $architecture

    # Check Kernel Release
    puts {\E[32m}"Kernel Release :" $tecreset $kernelrelease

    # Check hostname
    puts {\E[32m}"Hostname :" $tecreset $hostname

    # Check Internal IP
    puts {\E[32m}"Internal IP :" $tecreset $internalip

    # Check External IP
    puts {\E[32m}"External IP :" $tecreset $externalip

    # Check DNS
    puts {\E[32m}"Name Servers :" $tecreset $nameservers

    if {$SKIPWHO != "1"} {
        echo -e {\E[32m}"Logged In users :" $tecreset && cat /tmp/who
    }

    # Check RAM and SWAP Usages
    puts {\E[32m}"Ram Usages :" $tecreset
    -> slurp /tmp/ramcache | grep -v "Swap"
    puts {\E[32m}"Swap Usages :" $tecreset
    -> slurp /tmp/ramcache | grep -v "Mem" | awk -F'shared' '{print $1}'

    # Check Disk Usages
    set diskusage [-> df -h | grep "Filesystem|/dev/.*da*"]
    puts {\E[32m}"Disk Usages :" $tecreset $diskusage

    # Check Load Average
    puts {\E[32m}"Load Average :" $tecreset $loadaverage

    # Check System Uptime
    puts {\E[32m}"System Uptime Days/(HH:MM) :" $tecreset $tecuptime

    # Unset Variables
    unset tecreset os architecture kernelrelease internalip externalip nameserver loadaverage
    remove_files
}
#shift $(($OPTIND -1))
