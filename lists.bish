#!bish

set files {
    app.tcl
    config.tcl
    README.md
    app.tcl
    tests.tcl
    old.tcl
    utils.tcl
}

set excluded {
    old.tcl
    README.md
}

set files [lsort -unique $files]

set deploy {}
foreach f $files {
    if {[lsearch -exact $excluded $f] < 0} {
        lappend deploy $f
    }
}

set deploy [linsert $deploy 0 bootstrap.tcl]
set deploy [lreplace $deploy end end generated.tcl]
set deploy [lreplace $deploy 1 1 main.tcl]
set deploy [lsort $deploy]

set first [lindex $deploy 0]
set last [lindex $deploy end]
set middle [lrange $deploy 1 end-1]

set config [list --output release --verbose]
set config [lreplace $config 1 1 staging]
set config [linsert $config end --force]
set config [concat $config [list --include $first]]
set config [lappend config --exclude $last]

set args [concat $config $deploy]
set args [lreplace $args 0 0 --destination]
set preview [join $deploy ", "]
set count [llength $deploy]

puts "Deploying $count files: $preview"
puts "First: $first; last: $last"
puts "Middle files: [join $middle {, }]"
puts "Command: deploy-tool [join $args { }]"
