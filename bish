#!/usr/bin/env tclsh

package require Tcl 8.6

# ---
# Wiring up
# ---

namespace eval ::bish {
    namespace export alias emit

    source [file join [file dirname [info script]] lint.tcl]
    source [file join [file dirname [info script]] error.tcl]
    source [file join [file dirname [info script]] builtins.tcl]
    source [file join [file dirname [info script]] gunt.tcl]

    variable signals {
        SIGHUP   1
        SIGINT   2
        SIGQUIT  3
        SIGILL   4
        SIGTRAP  5
        SIGABRT  6
        SIGBUS   7
        SIGFPE   8
        SIGKILL  9
        SIGUSR1 10
        SIGSEGV 11
        SIGUSR2 12
        SIGPIPE 13
        SIGALRM 14
        SIGTERM 15
        SIGSTOP 19
        SIGTSTP 20
    }

    variable self [file normalize [info script]]
    variable stmts {}

    variable scriptname ""
    variable line_number 0
    variable last_command ""

    variable colors {red 31 yellow 33 aqua 96 purple 35 cyan 36}

    variable use_color [expr {
        ![info exists ::env(NO_COLOR)]
        && [dict exists [chan configure stderr] -mode]
    }]
}

proc ::bish::signal-number {sig} {
    variable signals
    expr {[dict exists $signals $sig] ? [dict get $signals $sig] : 0}
}

rename ::unknown ::bish::tcl_unknown

proc ::unknown {name args} {
    if {[string first :: $name] < 0} {
        set path [::bish::which $name]
        if {$path ne ""} {
            return [::bish::run_system_command_ex $name $path $args]
        }
    }
    # Snapshot the stack now; after tcl_unknown fails it is gone.
    ::bish::capture [list [list TCL LOOKUP COMMAND $name] \
        "invalid command name \"$name\""]
    tailcall ::bish::tcl_unknown $name {*}$args
}

# ---
# System command invocation
# ---
proc ::bish::resolve {name} {
    set path [which $name]
    if {$path eq ""} {
        return -code error -errorcode [list BISH NOTFOUND $name] \
            "command not found: $name"
    }
    return $path
}

proc ::bish::run_system_command_ex {name path argv} {
    flush stdout
    flush stderr

    set chan [open |[list $path {*}$argv <@ stdin 2>@1] r]
    fconfigure $chan -translation lf
    set out [read $chan]

    set ::err 0
    try {
        close $chan
    } trap CHILDSTATUS {msg opts} {
        set ::err [lindex [dict get $opts -errorcode] 2]
    } trap CHILDKILLED {msg opts} - trap CHILDSUSP {msg opts} {
        set ::err [expr {128 + [signal-number [lindex [dict get $opts -errorcode] 2]]}]
    }

    if {[string index $out end] eq "\n"} {
        set out [string range $out 0 end-1]
    }
    return $out
}

proc ::bish::run_system_command {name args} {
    run_system_command_ex $name [resolve $name] $args
}

# ---
# Builtins
# ---

# XXX
#proc ::bish::emit {script}

proc ::bish::capture {key} {
    variable self
    variable stmts
    variable trace
    variable trace_key

    set items $stmts
    set n [info frame]
    for {set i 1} {$i <= $n} {incr i} {
        set fr [info frame $i]
        if {![dict exists $fr file] || ![dict exists $fr line]
            || ![dict exists $fr cmd]} continue
        set file [file normalize [dict get $fr file]]
        if {$file eq $self} continue
        lappend items [list $i $file [dict get $fr line] \
                            [string trim [dict get $fr cmd]]]
    }
    set trace [lsort -integer -index 0 $items]
    set trace_key $key
}

# ---
# Entry point
# ---

# XXX this will eventually be exported to C
# Runs before every command executed under [source]. Records where we are,
# so after a failure these hold the location of the command that failed.
proc ::bish::step {cmd op} {
    variable scriptname
    variable line_number
    variable last_command

    # Frame -1 is the trace's own eval; -2 is the command about to run.
    set fr [info frame -2]
    if {![dict exists $fr file] || ![dict exists $fr line]} return
    # Ignore commands running inside bish's own procs.
    if {[file normalize [dict get $fr file]] ne $scriptname} return
    set line_number [dict get $fr line]
    set last_command $cmd
}

proc ::bish::main {argv} {
    variable scriptname
    variable line_number
    variable last_command

    if {[llength $argv] < 1} {
        puts stderr "usage: bish script ?arg ...?"
        exit 2
    }

    set script [lindex $argv 0]
    set ::argv0 $script
    set ::argv  [lrange $argv 1 end]
    set ::argc  [llength $::argv]
    set ::err   0

    uplevel #0 [list namespace import ::bish::*]

    if {[catch {::bish::lint $script} msg]} {
        puts stderr $msg
        exit 2
    }

    set scriptname [file normalize $script]
    set line_number 0
    set last_command ""

    trace add execution ::source enterstep ::bish::step
    set code [catch {uplevel #0 [list source $script]} msg opts]
    trace remove execution ::source enterstep ::bish::step

    if {$code == 1} {
        puts stderr [report $msg $trace]
        exit 1
    }
}
::bish::main $::argv
