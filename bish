#!/usr/bin/env tclsh

package require Tcl 8.6

# ---
# Wiring up
# ---

namespace eval ::bish {
    namespace export run emit pipe

    source [file join [file dirname [info script]] builtins.tcl]
    source [file join [file dirname [info script]] lint.tcl]

    variable signals {
        SIGHUP   1
        SIGINT   2
        SIGQUIT  3
        SIGILL   4
        SIGTRAP  5
        SIGABRT  6
        SIGBUS   7
        SIGFPE   8
        SIGKILL  9
        SIGUSR1 10
        SIGSEGV 11
        SIGUSR2 12
        SIGPIPE 13
        SIGALRM 14
        SIGTERM 15
        SIGSTOP 19
        SIGTSTP 20
    }

    variable self [file normalize [info script]]
    variable stmts {}
    variable trace {}
    variable trace_key {}

    variable colors {red 31 yellow 33 aqua 96 purple 35 cyan 36}

    variable use_color [expr {
        ![info exists ::env(NO_COLOR)]
        && [dict exists [chan configure stderr] -mode]
    }]
}

proc ::bish::signal-number {sig} {
    variable signals
    expr {[dict exists $signals $sig] ? [dict get $signals $sig] : 0}
}

rename ::unknown ::bish::tcl_unknown

proc ::unknown {name args} {
    if {[string first :: $name] < 0} {
        set path [::bish::which $name]
        if {$path ne ""} {
            return [::bish::invoke $name $path $args]
        }
    }
    # Snapshot the stack now; after tcl_unknown fails it is gone.
    ::bish::capture [list [list TCL LOOKUP COMMAND $name] \
        "invalid command name \"$name\""]
    tailcall ::bish::tcl_unknown $name {*}$args
}

# ---
# System command invocation
# ---
proc ::bish::resolve {name} {
    set path [which $name]
    if {$path eq ""} {
        return -code error -errorcode [list BISH NOTFOUND $name] \
            "command not found: $name"
    }
    return $path
}

proc ::bish::invoke {name path argv} {
    flush stdout
    flush stderr

    set chan [open |[list $path {*}$argv <@ stdin 2>@1] r]
    fconfigure $chan -translation lf
    set out [read $chan]

    set ::err 0
    try {
        close $chan
    } trap CHILDSTATUS {msg opts} {
        set ::err [lindex [dict get $opts -errorcode] 2]
    } trap CHILDKILLED {msg opts} - trap CHILDSUSP {msg opts} {
        set ::err [expr {128 + [signal-number [lindex [dict get $opts -errorcode] 2]]}]
    }

    if {[string index $out end] eq "\n"} {
        set out [string range $out 0 end-1]
    }
    return $out
}

proc ::bish::run {name args} {
    invoke $name [resolve $name] $args
}

# ---
# Builtins
# ---

# XXX this will eventually be exported to C
# Cut a script into a list of {sep text} and {stmt text} pieces. Joined
# back together the texts reproduce the script exactly. Statements end at
# an unquoted newline or semicolon, found by growing a candidate until
# [info complete] accepts it. Tcl's own notion of a complete command does
# all the parsing; nothing here looks inside words.
proc ::bish::split_script {script} {
    set n [string length $script]
    set parts {}
    set i 0
    while {$i < $n} {
        # Whitespace and semicolons between statements.
        set j $i
        while {$j < $n && [string first [string index $script $j] " \t\r\n;"] >= 0} {
            incr j
        }
        if {$j > $i} {
            lappend parts [list sep [string range $script $i [expr {$j - 1}]]]
            set i $j
            continue
        }

        # A comment runs to the end of the line; a backslash-newline
        # continues it.
        if {[string index $script $i] eq "#"} {
            set j $i
            while {$j < $n} {
                set c [string index $script $j]
                if {$c eq "\\"} {
                    incr j 2
                    continue
                }
                if {$c eq "\n"} break
                incr j
            }
            if {$j > $n} {
                set j $n
            }
            lappend parts [list sep [string range $script $i [expr {$j - 1}]]]
            set i $j
            continue
        }

        # A statement.
        set j $i
        while {1} {
            set a [string first "\n" $script $j]
            set b [string first ";" $script $j]
            if {$a < 0} {
                set k $b
            } elseif {$b < 0} {
                set k $a
            } else {
                set k [expr {min($a, $b)}]
            }
            if {$k < 0} {
                set k $n
            }
            set cand [string range $script $i [expr {$k - 1}]]
            if {$k >= $n} break
            # [info complete] accepts a trailing backslash, but a
            # backslash-newline continues the statement.
            regexp {\\*$} $cand bs
            if {[info complete $cand] && [string length $bs] % 2 == 0} break
            set j [expr {$k + 1}]
        }
        lappend parts [list stmt $cand]
        set i $k
    }
    return $parts
}

proc ::bish::emit {script} {
    variable stmts
    variable trace
    variable trace_key

    set fr [info frame -1]
    set file [expr {[dict exists $fr file] ? [file normalize [dict get $fr file]] : "?"}]
    set line [expr {[dict exists $fr line] ? [dict get $fr line] : 0}]
    set level [info frame]

    foreach part [split_script $script] {
        lassign $part kind text
        if {$kind eq "stmt"} {
            lappend stmts [list $level $file $line [string trim $text]]
            set code [catch {uplevel 1 $text} result opts]
            if {$code != 0} {
                set key [list [dict get $opts -errorcode] $result]
                if {$code == 1 && $key ne $trace_key} {
                    capture $key
                }
                set stmts [lrange $stmts 0 end-1]
                dict incr opts -level
                return -options $opts $result
            }
            set stmts [lrange $stmts 0 end-1]
            set trace {}
            set trace_key {}
            if {$result ne ""} {
                puts $result
            }
        }
        incr line [regexp -all {\n} $text]
    }
    return
}

proc ::bish::capture {key} {
    variable self
    variable stmts
    variable trace
    variable trace_key

    set items {}
    foreach s $stmts {
        lappend items $s
    }
    set n [info frame]
    for {set i 1} {$i <= $n} {incr i} {
        set fr [info frame $i]
        foreach k {file line cmd} {
            if {![dict exists $fr $k]} continue
        }
        if {![dict exists $fr file] || ![dict exists $fr line]
            || ![dict exists $fr cmd]} continue
        set file [file normalize [dict get $fr file]]
        if {$file eq $self} continue
        set cmd [dict get $fr cmd]
        if {[lindex [split $cmd] 0] in {emit ::bish::emit}} continue
        lappend items [list $i $file [dict get $fr line] [string trim $cmd]]
    }
    set trace [lsort -integer -index 0 $items]
    set trace_key $key
}

proc ::bish::paint {color text} {
    variable colors
    variable use_color
    if {!$use_color} {
        return $text
    }
    return "\033\[[dict get $colors $color]m$text\033\[0m"
}

proc ::bish::loc {file line} {
    return "[paint purple $file]:[paint cyan $line]"
}

# $mark is already painted; every line of $text gets it.
proc ::bish::margin {mark text} {
    return "$mark [string map [list \n "\n$mark "] $text]"
}

proc ::bish::report {msg ec} {
    variable trace
    variable trace_key

    # XXX error reporting must be merged in the future
    set hash [paint red #]
    set bar  [paint yellow |]

    if {[list $ec $msg] ne $trace_key || [llength $trace] == 0} {
        return [margin $hash "[paint red "error:"] $msg"]
    }

    set out {}
    foreach item [lrange $trace 0 end-1] {
        lassign $item _ file line text
        lappend out [margin $hash "[paint aqua "from:"] [loc $file $line]"] \
                    [margin $bar $text]
    }
    lassign [lindex $trace end] _ file line text
    lappend out [margin $hash "[paint red "error:"] [loc $file $line]: $msg"] \
                [margin $bar $text]
    return [join $out \n]
}

proc ::bish::reap {chan} {
    set ::err 0
    try {
        close $chan
    } trap CHILDSTATUS {msg opts} {
        set ::err [lindex [dict get $opts -errorcode] 2]
    } trap CHILDKILLED {msg opts} - trap CHILDSUSP {msg opts} {
        set ::err [expr {128 + [signal-number [lindex [dict get $opts -errorcode] 2]]}]
    }
}

proc ::bish::run_group {group data have} {
    set cmdline {}
    foreach c $group {
        if {[llength $cmdline]} {
            lappend cmdline |
        }
        lappend cmdline {*}$c
    }
    if {$have} {
        if {$data ne ""} {
            append data \n
        }
        lappend cmdline << $data
    } else {
        lappend cmdline <@ stdin
    }
    lappend cmdline 2>@1

    flush stdout
    flush stderr
    set chan [open |$cmdline r]
    fconfigure $chan -translation lf
    set out [read $chan]
    reap $chan

    if {[string index $out end] eq "\n"} {
        set out [string range $out 0 end-1]
    }
    return $out
}

proc ::bish::is_system {name} {
    expr {[namespace which -command $name] eq ""}
}

proc ::bish::pipe {args} {
    set data {}
    set have 0
    set split 0
    set group {}
    set gdata {}
    set ghave 0

    foreach stage $args {
        if {$stage eq "*"} {
            # Finish any pending OS pipeline to get the output to split.
            if {[llength $group]} {
                set data [run_group $group $gdata $ghave]
                set have 1
                set group {}
            }
            if {!$have} {
                return -code error "pipe: * must follow a stage"
            }
            set split 1
            continue
        }

        set name [lindex $stage 0]
        set argv [lrange $stage 1 end]

        set expanded_argv {}
        foreach arg $argv {
            lappend expanded_argv [uplevel 1 [list subst $arg]]
        }
        set argv $expanded_argv

        if {[is_system $name]} {
            if {$split} {
                # The output becomes arguments, so it can't feed stdin too.
                lappend argv {*}$data
                set split 0
                set gdata {}
                set ghave 0
            } elseif {![llength $group]} {
                set gdata $data
                set ghave $have
            }
            lappend group [list [resolve $name] {*}$argv]
            continue
        }

        if {[llength $group]} {
            set data [run_group $group $gdata $ghave]
            set have 1
            set group {}
        }
        if {$have} {
            if {$split} {
                lappend argv {*}$data
            } else {
                lappend argv $data
            }
        }
        set split 0
        set data [uplevel 1 [list $name {*}$argv]]
        set have 1
    }

    if {$split} {
        return -code error "pipe: * must be followed by a stage"
    }
    if {[llength $group]} {
        set data [run_group $group $gdata $ghave]
    }
    return $data
}

# ---
# Entry point
# ---

proc ::bish::main {argv} {
    if {[llength $argv] < 1} {
        puts stderr "usage: bish script ?arg ...?"
        exit 2
    }

    set script [lindex $argv 0]
    set ::argv0 $script
    set ::argv  [lrange $argv 1 end]
    set ::argc  [llength $::argv]
    set ::err   0

    uplevel #0 [list namespace import ::bish::*]

    if {[catch {::bish::lint $script} msg]} {
        puts stderr $msg
        exit 2
    }

    if {[catch {uplevel #0 [list source $script]} msg opts]} {
        set ec [expr {[dict exists $opts -errorcode] ? [dict get $opts -errorcode] : ""}]
        if {[lindex $ec 0] eq "BISH"} {
            puts stderr "bish: $msg"
        } else {
            puts stderr [::bish::report $msg $ec]
        }
        exit 1
    }
}

::bish::main $::argv
